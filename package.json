    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^4.18.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
