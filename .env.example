# LeadFlow AI — environment configuration
#
# Copy to `.env` and fill in. Variables are validated at startup by lib/env.ts;
# a missing or malformed REQUIRED value stops the app from booting.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. Neon is the chosen host (docs/architecture.md §3.3).
# Any PostgreSQL 14+ instance works for local development.
DATABASE_URL="postgresql://user:password@localhost:5432/leadflow?schema=public"

# Auth.js signing/encryption secret. Minimum 32 characters.
# Generate one with:  npx auth secret     (or)     openssl rand -base64 32
AUTH_SECRET=""

# --- Optional ---------------------------------------------------------------

# Canonical app URL. Not needed in local development or on Vercel.
#
# SET THIS for any self-hosted, internet-facing deployment. The app enables
# Auth.js `trustHost` (required outside Vercel), which otherwise derives
# callback URLs from the client-supplied Host header. AUTH_URL pins them.
# AUTH_URL="https://app.example.com"

# --- Inngest (Phase 2C — workflow execution engine) -------------------------
#
# Both optional. `npx inngest-cli dev` needs neither locally. In production
# INNGEST_SIGNING_KEY is what lets /api/inngest verify that a request really
# came from Inngest, so set both there.

# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# --- Optional integrations (Phase 3-5) --------------------------------------
#
# The application starts and runs correctly WITHOUT any of these. Each one
# simply leaves its integration unconfigured until the relevant phase.

# OPENAI_API_KEY=""            # Phase 3 — AI qualification
# OPENAI_QUALIFICATION_MODEL="" # Optional; defaults to gpt-5
# APOLLO_API_KEY=""            # Phase 2D-4 — lead enrichment
# PROSPEO_API_KEY=""           # Phase 2D-6 — lead enrichment (takes precedence over Apollo)
# AIRTABLE_API_KEY=""          # Phase 5 — CRM sync
# SLACK_BOT_TOKEN=""           # Phase 5 — team notifications
# EMAIL_PROVIDER_API_KEY=""    # Phase 4 — vendor not yet selected
